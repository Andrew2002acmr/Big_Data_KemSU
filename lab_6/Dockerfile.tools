FROM docker:28.3-cli AS docker-cli
FROM python:3.12-slim-bookworm
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git \
 && rm -rf /var/lib/apt/lists/*
RUN curl --retry 3 --retry-all-errors --connect-timeout 15 -fsSLo /usr/local/bin/kind "https://github.com/kubernetes-sigs/kind/releases/download/v0.29.0/kind-linux-${TARGETARCH}" \
 && curl --retry 3 --retry-all-errors --connect-timeout 15 -fsSLo /usr/local/bin/kubectl "https://dl.k8s.io/release/v1.33.1/bin/linux/${TARGETARCH}/kubectl" \
 && curl --retry 3 --retry-all-errors --connect-timeout 15 -fsSLo /tmp/helm.tgz "https://get.helm.sh/helm-v3.18.6-linux-${TARGETARCH}.tar.gz" \
 && tar -xzf /tmp/helm.tgz --strip-components=1 -C /usr/local/bin "linux-${TARGETARCH}/helm" \
 && rm /tmp/helm.tgz \
 && chmod +x /usr/local/bin/kind /usr/local/bin/kubectl /usr/local/bin/helm
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx
ENV DOCKER_BUILDKIT=1
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
